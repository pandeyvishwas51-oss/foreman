# Copy to .env. With nothing set, FOREMAN runs on a simulated Razorpay with rule-based agents.

# Claude makes the agents' decisions. Without it, fixed rules stand in and the page says so.
ANTHROPIC_API_KEY=
# Or, with no API key: run the agents through the Claude Agent SDK with the Claude subscription signed in on this machine.
FOREMAN_AGENTS=

# Razorpay TEST keys (Dashboard > Account & Settings > API Keys, in Test Mode). Live keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RazorpayX test-mode account number (RazorpayX Dashboard > Test Mode > My Account & Settings > Banking).
RAZORPAYX_ACCOUNT_NUMBER=
# Webhook secret set in the Dashboard, if webhooks point at this server. Leave empty to confirm by polling.
RAZORPAY_WEBHOOK_SECRET=
# Mandate method for the one-time authorisation: card (works fully in test mode) or upi (UPI AutoPay).
RAZORPAY_MANDATE=card

# Public https address of this server, so Razorpay can deliver webhooks. On Render this is picked up automatically.
PUBLIC_URL=
# Pause between a rule-based agent's answers, so the page can be read (ms). Models need no pause.
FOREMAN_PACE_MS=1500
